pipeline{
    agent any
    stages{
      stage("compile"){
        steps{
            echo ('compiling the code')
            sleep 6
            //sh 'exit 1'
        }
      }
      stage("build"){
        steps{
            echo ('building the code')
            sleep 120
        }
      }
        stage("deploy"){
steps{
echo "deploy stage"
}
            
        }
    }

}
