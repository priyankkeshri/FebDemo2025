pipeline{
    agent none
    stages{
      stage("compile"){
agent{
label "slave1"
}
        steps{
            echo ('compiling the code')
            sleep 6
            //sh 'exit 1'
        }
      }
      stage("build"){
agent{
label "slave1"
}
        steps{
            echo ('building the code')
            sleep 5
        }
      }
       
    }

}
